@{
    Layout = "_Layout";

    ViewData["Title"] = "Cadastrar mesa";

    if (TempData["FalhaCadMesa"] != null) {
        <div class="alert alert-danger" role="alert">
            @TempData["FalhaCadMesa"]
        </div>
    }

    if (TempData["SucessoCadMesa"] != null) {
        <div class="alert alert-success" role="alert">
            @TempData["SucessoCadMesa"]
        </div>
    }
}

<script src="~/js/mesa.js"></script>

<div class="form-group">
    <label for="numeroMesaInput">Número</label>
    <input type="text" class="form-control" id="numeroMesaInput" placeholder="Número">
</div>
<button type="submit" class="btn btn-primary" onclick="criarMesa()">Cadastrar mesa</button>

<table class="table" id="tabelaMesas" style="margin-top:100px">
  <thead>
    <tr>
      <th scope="col">Número</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
   
  </tbody>
</table>


<div class="modal fade" id="modalCadastroMesa" tabindex="-1" role="dialog" aria-labelledby="modalCadastroMesa" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="headerModalCadastroMesa">
                <h5 class="modal-title" id="modalCadastroMesa">Cadastro Mesa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="statusCadastroMesa"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>