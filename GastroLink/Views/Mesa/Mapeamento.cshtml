@model IEnumerable<Mesa>;

@{
    Layout = "_Layout";
    ViewData["Title"] = "Mapeamento Mesas";
}
<link rel="stylesheet" href="~/css/mapeamento-mesa.css" media="all" />

<div class="mapa" id="mapa">
    @{
        foreach(var mesa in Model){
            <div class="mesa" style="left:@(mesa.PosicaoX)px; top:@(mesa.PosicaoY)px;" data-id="@mesa.Id">
                Mesa @mesa.Numero
            </div>
        }
    }
</div>

<button class="btn btn-success" onclick="salvarLayout()">
    Salvar Layout
</button>

<div class="modal fade" id="modalSalvarLayout" tabindex="-1" role="dialog" aria-labelledby="modalSalvarLayout" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="headerSalvarLayout">
                <h5 class="modal-title" id="modalSalvarLayout">Salvar Layout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="statusSalvarLayout"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/mapeamento.js"></script>