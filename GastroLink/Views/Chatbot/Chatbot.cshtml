@{
    ViewData["Title"] = "Chatbot";
}

<link rel="stylesheet" href="~/css/chatbot.css" />

<div class="chat-page">
    <div class="chat-container">
        <div class="chat-card">
            <div class="chat-header">
                <div class="chat-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div class="chat-header-info">
                    <span class="chat-title">GastroBot</span>
                    <span class="chat-subtitle">assistente de recomendações</span>
                </div>
            </div>

            <div id="chat-box">
                <div class="msg-bot">
                    Olá! Sou o <strong>GastroBot</strong>.

                    Posso te ajudar a encontrar um prato que combine com o que você está procurando.

                    Me conte: o que você está com vontade de comer hoje?
                </div>
            </div>

            <div class="chat-footer">
                <form id="chat-form">
                    <input id="chat-input" type="text" class="form-control" placeholder="ex: quero algo leve..." autocomplete="off" />
                    <button type="submit" class="send-button" title="Enviar mensagem">
                        <i class="bi bi-send"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/js/chatbot.js"></script>