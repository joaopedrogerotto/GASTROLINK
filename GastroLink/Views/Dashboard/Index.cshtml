@model ResumoVendaViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex gap-2 align-items-end">

    <div style="flex: 1;">
        <label for="selectDashboard" class="form-label">Indicador</label>
        <select class="form-select" id="selectDashboard">
            <option selected>Selecione uma opção...</option>
            <option value="vendas-categoria">Vendas por categoria (barras)</option>
            <option value="vendas-forma-pagamento">Vendas por forma de pagamento (linhas)</option>
        </select>
    </div>

    <div style="flex: 1;">
        <label for="dataInicio" class="form-label">Data inicial</label>
        <input type="date" class="form-control" id="dataInicio" />
    </div>

    <div style="flex: 1;">
        <label for="dataFim" class="form-label">Data final</label>
        <input type="date" class="form-control" id="dataFim" />
    </div>

    <button type="button" class="btn btn-primary" id="gerarDashboard">
        Gerar
    </button>

</div>
<div>
    <canvas id="chart"></canvas>
</div>


<div class="row mt-4">

    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Produtos mais vendidos</h5>
            </div>

            <div class="card-body">

                @for (int i = 0; i < Model.VendasPrato.Count; i++) {
                    var prato = Model.VendasPrato[i];

                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">

                        <div class="d-flex align-items-center gap-3">
                            <strong class="text-muted">@(i + 1)º</strong>
                            <span>@prato.Nome </span>
                        </div>

                        <strong>@prato.Quantidade un.</strong>

                    </div>
                }

            </div>
        </div>
    </div>
    <div class="col-md-5">

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Resumo das vendas</h5>
            </div>

            <div class="card-body">

                <div class="mb-4">
                    <small class="text-muted">Faturamento</small>
                    <h3 class="mb-0">
                        R$ @Model.ResumoFaturamento.Faturamento.ToString("N2")
                    </h3>
                </div>

                <div class="mb-4">
                    <small class="text-muted">Pedidos realizados</small>
                    <h3 class="mb-0">
                        @Model.ResumoFaturamento.TotalVendidos
                    </h3>
                </div>

                <div>
                    <small class="text-muted">Ticket médio</small>
                    <h3 class="mb-0">
                        R$ @Model.ResumoFaturamento.TicketMedio.ToString("N2")
                    </h3>
                </div>

            </div>
        </div>

    </div>

</div>

<script src="/lib/chart/chart.umd.js"></script>
<script type="module" src="./js/dashboard.js"></script>