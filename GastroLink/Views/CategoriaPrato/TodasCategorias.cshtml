@model List<CategoriaPratoQuantidadeDTO>

@{
    ViewData["Title"] = "Todas categorias pratos";
}

<table class="table">
    <thead>
        <tr>
            <th scope="col">Categorias</th>
            <th scope="col">Quantidade de pratos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prato in Model) {
            <tr>

                <th scope="row">@prato.Categoria</th>
                <td>@prato.QuantidadePratos</td>
            </tr>
        }
    </tbody>
</table>