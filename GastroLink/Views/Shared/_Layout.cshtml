@inject IConfiguration Configuration;

@{
    var tipo = Context.Session.GetString("TipoUsuarioStr");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GastroLink</title>
    <script type="importmap"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr/dist/browser/signalr.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Courier+Prime&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GastroLink.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
            window.APP_CONFIG = {
                apiBaseUrl: "@Configuration["ApiGastroLink:BaseUrl"]",
                apiSignalR: "@Configuration["ApiGastroLink:BaseUrlSignalR"]",
                apiDashboard: "@Configuration["ApiGastroLink:BaseUrlDashboard"]",
                apiGemini: "@Configuration["ApiGemini:ApiKey"]",
            };
    </script>
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <span class="sidebar-logo">GastroLink</span>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    @if (tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle">
                                <i class="bi bi-grid-3x3-gap"></i> Mesas
                            </button>
                            <ul class="nav-submenu">
                                <li><a asp-action="Cadastrar" asp-controller="Mesa">Cadastro</a></li>
                                <li><a asp-action="TodasMesas" asp-controller="Mesa">Todas</a></li>
                                <li><a asp-action="Mapeamento" asp-controller="Mesa">Mapear</a></li>
                            </ul>
                        </li>

                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle">
                                <i class="bi bi-cash-coin"></i> Caixa
                            </button>
                            <ul class="nav-submenu">
                                <li><a asp-action="TodosPedidos" asp-controller="Caixa">Pedidos</a></li>
                            </ul>
                        </li>
                    }

                    @if (tipo == "ADMINISTRADOR") {
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle">
                                <i class="bi bi-people"></i> Usuário
                            </button>
                            <ul class="nav-submenu">
                                <li><a asp-action="CadastroUsuario" asp-controller="Usuario">Cadastro</a></li>
                                <li><a asp-action="TodosUsuarios" asp-controller="Usuario">Todos</a></li>
                            </ul>
                        </li>
                    }

                    @if (tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle">
                                <i class="bi bi-egg-fried"></i> Pratos
                            </button>
                            <ul class="nav-submenu">
                                <li class="nav-subheading">Categoria</li>
                                <li><a asp-action="Cadastrar" asp-controller="CategoriaPrato">Cadastrar</a></li>
                                <li><a asp-action="TodasCategorias" asp-controller="CategoriaPrato">Todas</a></li>

                                <li class="nav-subheading">Prato</li>
                                <li><a asp-action="Cadastrar" asp-controller="Prato">Cadastrar</a></li>
                                <li><a asp-action="TodosPratos" asp-controller="Prato">Todos Pratos</a></li>
                            </ul>
                        </li>
                    }

                    @if (tipo == "GARÇOM" || tipo == "ADMINISTRADOR" || tipo == "GERENTE" || tipo == "COZINHA") {
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle">
                                <i class="bi bi-receipt"></i> Pedidos
                            </button>
                            <ul class="nav-submenu">
                                @if (tipo == "GARÇOM" || tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                    <li class="nav-subheading">Garçom</li>
                                    <li><a asp-action="PedidosProntos" asp-controller="Garcom">Pedidos Prontos</a></li>
                                    <li><a asp-action="TodasMesas" asp-controller="Mesa">Mesas</a></li>
                                }
                                @if (tipo == "COZINHA" || tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                    <li class="nav-subheading">Cozinha</li>
                                    <li><a asp-action="TodosPedidos" asp-controller="Cozinha">Pedidos</a></li>
                                }
                            </ul>
                        </li>
                    }

                    @if (tipo == "ADMINISTRADOR") {
                        <li class="nav-single">
                            <a asp-action="Index" asp-controller="Dashboard">
                                <i class="bi bi-bar-chart"></i> Dashboard
                            </a>
                        </li>
                    }

                    @if (tipo == "ADMINISTRADOR" || tipo == "GERENTE" || tipo == "CHATBOT") {
                        <li class="nav-single">
                            <a asp-action="Chatbot" asp-controller="Chatbot">
                                <i class="bi bi-chat-dots"></i> Chatbot
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main-area">
            <header class="topbar">
                <button type="button" class="hamburger" id="sidebarToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="sidebar">
                    <span></span><span></span><span></span>
                </button>

                <a class="topbar-brand" asp-area="" asp-action="TodasMesas" asp-controller="Mesa">GastroLink</a>

                <div class="topbar-spacer"></div>

                <div class="dropdown user-menu">
                    <a class="user-menu-toggle dropdown-toggle" href="#" id="usuarioDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i> @Context.Session.GetString("NomeUsuario")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioDropdown">
                        <li>
                            <a class="dropdown-item text-danger" asp-action="Logout" asp-controller="Login">
                                <i class="bi bi-box-arrow-right"></i> Sair
                            </a>
                        </li>
                    </ul>
                </div>
            </header>

            <div class="container-conteudo">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="app-footer">
                &copy; @DateTime.Now.Year - GastroLink
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>