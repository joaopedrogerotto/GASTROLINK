@inject IConfiguration Configuration;

@{
    var tipo = Context.Session.GetString("TipoUsuarioStr");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GastroLink</title>
    <script type="importmap"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr/dist/browser/signalr.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GastroLink.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
            window.APP_CONFIG = {
                apiBaseUrl: "@Configuration["ApiGastroLink:BaseUrl"]",
                apiSignalR: "@Configuration["ApiGastroLink:BaseUrlSignalR"]"
            };
    </script>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-action="TodasMesas" asp-controller="Mesa">GastroLink</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            if (tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Mesas
                                    </a>


                                    <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-action="Cadastrar" asp-controller="Mesa">Cadastro</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="TodasMesas" asp-controller="Mesa">Todas</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Mapeamento" asp-controller="Mesa">Mapear</a>
                                        </li>
                                    </ul>

                                    
                                </li>


                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Caixa
                                    </a>


                                    <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-action="TodosPedidos" asp-controller="Caixa">Pedidos</a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            if (tipo == "ADMINISTRADOR") {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Usuario
                                    </a>


                                    <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-action="CadastroUsuario" asp-controller="Usuario">Cadastro</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="TodosUsuarios" asp-controller="Usuario">Todos</a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            if (tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Pratos
                                    </a>

                                        
                                    <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                        <li class="dropdown-submenu">
                                            <a class="dropdown-item dropdown-toggle" href="#">
                                                Categoria
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Cadastrar" asp-controller="CategoriaPrato">Cadastrar</a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item" asp-action="TodasCategorias" asp-controller="CategoriaPrato">Todas</a>
                                                </li>
                                            </ul>
                                        </li>
                                        <li class="dropdown-submenu">
                                            <a class="dropdown-item dropdown-toggle" href="#">
                                                Prato
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" asp-action="Cadastrar" asp-controller="Prato">Cadastrar</a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item" asp-action="TodosPratos" asp-controller="Prato">Todos Pratos</a>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Pedidos
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                    @if (tipo == "GARÇOM" || tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                        <li class="dropdown-submenu">
                                            <a class="dropdown-item dropdown-toggle" href="#">
                                                Garcom
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" asp-action="PedidosProntos" asp-controller="Garcom">Pedidos Prontos</a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-action="TodasMesas" asp-controller="Mesa">Mesas</a>
                                                </li>
                                            </ul>
                                        </li>
                                    }

                                    @if (tipo == "COZINHA" || tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                        <li class="dropdown-submenu">
                                            <a class="dropdown-item dropdown-toggle" href="#">
                                                Cozinha
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" asp-action="TodosPedidos" asp-controller="Cozinha">Pedidos</a>
                                                </li>
                                            </ul>
                                        </li>
                                    }
                                </ul>
                            </li>

                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="usuarioDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> @Context.Session.GetString("NomeUsuario")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioDropdown">
                                <li>
                                    <a class="dropdown-item text-danger" asp-action="Logout" asp-controller="Login">
                                        <i class="bi bi-box-arrow-right"></i> Sair
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - GastroLink
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
