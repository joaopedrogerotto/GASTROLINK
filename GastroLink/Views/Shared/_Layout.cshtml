@{
     var tipo = Context.Session.GetString("TipoUsuarioStr");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GastroLink</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GastroLink.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-action="TodasMesas" asp-controller="Mesa">GastroLink</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            if (tipo == "ADMINISTRADOR" || tipo == "GERENTE") {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Mesas
                                    </a>


                                    <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-action="Cadastrar" asp-controller="Mesa">Cadastro</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="TodasMesas" asp-controller="Mesa">Todas</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-action="Mapeamento" asp-controller="Mesa">Mapear</a>
                                        </li>
                                    </ul>
                                </li>

                                if(tipo == "ADMINISTRADOR"){
                                     <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="mesasDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Usuario
                                        </a>


                                        <ul class="dropdown-menu" aria-labelledby="mesasDropdown">
                                            <li>
                                                <a class="dropdown-item" asp-action="CadastroUsuario" asp-controller="Usuario">Cadastro</a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="TodosUsuarios" asp-controller="Usuario">Todos</a>
                                            </li>
                                        </ul>
                                    </li>
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - GastroLink
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
