@model IEnumerable<CategoriaPrato>

@{
    ViewData["Title"] = "Todos os Pratos";

    if (TempData["Falha"] != null) {
        <p class="text-danger text-center mt-3">
            @TempData["Falha"]
        </p>

    }
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<div class="d-flex align-items-center gap-3 mb-3">
    <div class="input-group flex-grow-1">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="titulo-opcoes" data-bs-toggle="dropdown" aria-expanded="false"> Categorias </button>
        <ul class="dropdown-menu" id="opcoes-pesquisa">
            @foreach (var item in Enum.GetValues<FiltroPesquisaPratoEnum>()) {
                <li>
                    <a class="dropdown-item opcao-filtro" data-valor="@item">@item</a>
                </li>
            }
        </ul>

        <input type="text" class="form-control" id="input-pesquisa" placeholder="Pesquisar...">
    </div>

    <select class="form-select" id="select-cat-prato" style="width: 250px;">
        <option value="" selected disabled hidden> Selecione uma categoria </option>

        @foreach (var categoria in Model) {
            <option value="@categoria.Id">@categoria.Categoria</option>
        }
    </select>

    <select class="form-select" id="select-disponibilidade" style="width: 250px;">
        <option value="" selected disabled hidden> Selecione a disponibilidade </option>
        <option value="1">Disponível</option>
        <option value="0">Indisponível</option>
    </select>

    <button class="btn btn-primary" id="btn-pesquisa-prato">Pesquisar</button>
    <button class="btn btn-success text-nowrap" id="btn-add-filtro">Adicionar Filtro</button>
</div>

<div id="list-filtro">
</div>


<div id="modalContainerPrato"></div>

<br />
<br />

<div id="lista-pratos">
    @await Html.PartialAsync("_ListaPratos", new List<Prato>())
</div>


<script type="module" src="~/js/prato.js"></script>
