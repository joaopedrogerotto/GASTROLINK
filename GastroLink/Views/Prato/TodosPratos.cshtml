@{
    ViewData["Title"] = "Todos os Pratos";

    if (TempData["Falha"] != null) {
        <p class="text-danger text-center mt-3">
            @TempData["Falha"]
        </p>

    }
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<div>
    <div class="input-group mb-3">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="titulo-opcoes" data-bs-toggle="dropdown" aria-expanded="false">Categorias</button>
        <ul class="dropdown-menu" id="opcoes-pesquisa">
            @{
                foreach(var item in Enum.GetValues<FiltroPesquisaPratoEnum>()){
                    <li><a class="dropdown-item opcao-filtro" data-valor="@item">@item</a></li>
                }
            }
        </ul>
        <input type="text" class="form-control" id="input-pesquisa" placeholder="Pesquisar..." aria-label="Search">
        <button class="btn btn-primary" id="btn-pesquisa-prato">Pesquisar</button>
        <button class="btn btn-success" id="btn-add-filtro">Adicionar Filtro</button>
    </div>
</div>

<div id="list-filtro">

</div>

<div id="lista-pratos">
    @await Html.PartialAsync("_ListaPratos", new List<Prato>())
</div>