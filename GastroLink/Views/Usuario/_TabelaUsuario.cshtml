@model IEnumerable<Usuario>

<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nome</th>
            <th scope="col">Login</th>
            <th scope="col">Status</th>
            <th scope="col">Tipo de Usuario</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model) {
            <tr>

                <th scope="row">@usuario.Id</th>
                <td>@usuario.Nome</td>
                <td>@usuario.Login</td>
                <td>@(usuario.Status ? "Ativo" : "Inativo")</td>
                <td>@usuario.Tipo.Tipo</td>
                <td class="links-acoes">
                    <a id="editar-usuario" data-id="@usuario.Id"><i class="bi bi-pencil-fill"></i></a>
                    <a id="info-usuario" data-id="@usuario.Id"><i class="bi bi-info-circle-fill"></i></a>

                    @if (usuario.Status) {
                        <a id="ativar-usuario" data-id="@usuario.Id"><i class="bi bi-lock-fill"></i></a>
                    }else{
                        <a id="inativar-usuario" data-id="@usuario.Id"><i class="bi bi-unlock-fill"></i></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="modalContainer"></div>

<div class="modal fade" id="modalSucessoUsuario" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloSucessoUsuario">Atualização Usuário</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="textSucessoUsuario">
                Usuário atualizado com sucesso.
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">OK</button>
            </div>

        </div>
    </div>
</div>