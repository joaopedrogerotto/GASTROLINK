@model Usuario

<style>
    input[readonly] {
        background-color: #e9ecef !important;
        opacity: 1;
        cursor: not-allowed;
        color: #6c757d;
    }
</style>

<div class="modal fade" id="visualizarUsuarioModal" tabindex="-1" role="dialog" aria-labelledby="visualizarUsuarioModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="visualizarUsuarioModalLabel">Visualizar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <label for="usu_nome">Nome Completo:</label>
                        <input type="text" class="form-control" id="usu_nome" asp-for="@Model.Nome" readonly>
                    </div>
                    <div class="form-group">
                        <label for="usu_login">Login:</label>
                        <input type="text" class="form-control" id="usu_login" asp-for="@Model.Login" readonly>
                    </div>
                    <div class="form-group">
                        <label for="senha">Tipo de Usuario:</label>
                        <input type="text" class="form-control" id="usu_login" asp-for="@Model.Tipo.Tipo" readonly>
                    </div>
                    <div class="form-group">
                        <label for="senha">Status:</label>
                        <input type="text" class="form-control" id="usu_login" asp-for="@Model.Status" value="@(Model.Status ? "ATIVO":"INATIVO")" readonly>
                    </div>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>