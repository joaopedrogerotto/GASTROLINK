@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Todos de Usuario";
}

<link rel="stylesheet" href="~/css/tabela-usuarios.css" media="all" />

<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nome</th>
            <th scope="col">Login</th>
            <th scope="col">Status</th>
            <th scope="col">Tipo de Usuario</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model) {
            <tr>

                <th scope="row">@usuario.Id</th>
                <td>@usuario.Nome</td>
                <td>@usuario.Login</td>
                <td>@(usuario.Status ? "Ativo" : "Inativo")</td>
                <td>@usuario.Tipo.Tipo</td>
                <td class="links-acoes">
                    <a id="editar-usuario"><i class="bi bi-pencil-fill"></i></a>
                    <a id="info-usuario" onclick="visualizarUsuario(@usuario.Id)"><i class="bi bi-info-circle-fill"></i></a>
                    <a id="excluir-usuario"><i class="bi bi-trash-fill"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="modalContainer"></div>

<script src="~/js/tabelaUsuario.js"></script>