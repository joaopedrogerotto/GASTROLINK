@model CriarPedidoViewModel

@{
    ViewData["Title"] = "Criar Pedido";
    var categorias = Model.listCategoriaPrato;
}

<link rel="stylesheet" href="~/css/cardapio.css" media="all" />


<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Mesa @Model.idMesa</h4>

    <button id="btnResumoPedido" class="btn btn-outline-primary position-relative">
        <i class="bi bi-cart"></i>
        <span id="quantidadeItensPedido" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            0
        </span>
    </button>
</div>
<input type="hidden" value="@Model.idMesa" id="mesaPedido"/>
<ul class="nav nav-tabs mb-3" id="cardapioTabs" role="tablist">
    @for (int i = 0; i < categorias.Count; i++)
    {
        var categoria = categorias[i];

        <li class="nav-item" role="presentation">
            <button class="nav-link @(i == 0 ? "active" : "")" id="tab-@categoria.Id" data-bs-toggle="tab" data-bs-target="#categoria-@categoria.Id" type="button" role="tab">
                @categoria.Categoria
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    @for (int i = 0; i < categorias.Count; i++)
    {
        var categoria = categorias[i];

        <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="categoria-@categoria.Id" role="tabpanel">
            @await Html.PartialAsync("_ListaPratos", categoria.Pratos)
        </div>
    }
</div>

<div class="modal fade" id="modalSucessoItemPedido" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloSucessoItemPedido">Pedido Adicionado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="textSucessoItemPedido">
                Item adicionado com sucesso.
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">OK</button>
            </div>

        </div>
    </div>
</div>

<div id="modalContainerResumo"></div>
<script src="~/js/cardapio.js" type="module"></script>