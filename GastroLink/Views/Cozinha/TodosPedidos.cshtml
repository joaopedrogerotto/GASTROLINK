@model IEnumerable<Pedido>

@{
    ViewData["Title"] = "Cozinha";
}

<script src="~/js/cozinha.js" type="module"></script>

<div id="containerPedidos">
    @foreach (var pedido in Model) {
        <div class="card card-pedido">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Pedido #@pedido.Id</span>
                <small class="text-muted">
                    @pedido.dataCriacao.ToString("dd/MM/yyyy HH:mm")
                </small>
            </div>
            <div class="card-body">
                <h5 class="card-title">Mesa @pedido.Mesa.Numero</h5>
                @foreach (var itemPedido in pedido.Itens) {
                    <p class="card-text">Prato: @itemPedido.Prato.Nome</p>
                    <p class="card-text">Quantidade: @itemPedido.Quantidade</p>
                    <p class="card-text">Observação: @itemPedido.Observacao</p>
                    <hr />
                }
                @switch(pedido.Status.Id){
                    case 1:
                        <button href="#" class="btn btn-info" data-id-pedido="@pedido.Id" data-id-status="3" id="btnPedidoPronto">EM PREPARO</button>
                        break;
                    case 3:
                        <button href="#" class="btn btn-success" data-id-pedido="@pedido.Id" data-id-status="4" id="btnPedidoPronto">PRONTO</button>
                        break;
                }
            </div>
        </div>
        <br>
    }
</div>